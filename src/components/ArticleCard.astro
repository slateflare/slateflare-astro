---
import type { CollectionEntry } from "astro:content";

const { article } = Astro.props;

interface Props {
  article: CollectionEntry<"blog">;
}
---

<article
  class="group flex h-full flex-col overflow-hidden rounded-2xl border border-border bg-surface transition duration-300 hover:-translate-y-1 hover:shadow-lg"
>
  <a href={"/articles/" + article.data.slug} class="block overflow-hidden">
    <div class="aspect-16/10 overflow-hidden">
      <img
        src={article.data.image}
        alt={article.data.title}
        loading="lazy"
        class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
      />
    </div>
  </a>

  <div class="flex flex-1 flex-col p-5">
    <div class="flex flex-wrap items-center gap-2">
      <span class="text-xs font-semibold text-flare"
        >{article.data.tags[0] ?? "General"}</span
      >

      <span class="text-xs text-muted">•</span>

      <time datetime="2026-09-05" class="text-xs text-muted">
        {
          article.data.pubDate.toLocaleDateString("en-US", {
            year: "numeric",
            month: "long",
            day: "numeric",
          })
        }
      </time>
    </div>

    <h3 class="mt-3 text-lg font-bold leading-6 text-text">
      <a
        href={"/articles/" + article.data.slug}
        class="transition group-hover:text-flare"
      >
        {article.data.title}
      </a>
    </h3>

    <p class="mt-3 line-clamp-3 text-sm leading-6 text-muted">
      {article.data.description}
    </p>

    <div class="mt-auto pt-5">
      <p class="text-xs font-medium text-text">By {article.data.author}</p>
    </div>
  </div>
</article>
