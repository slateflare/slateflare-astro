---
import { ArrowRight } from "@lucide/astro";
---

<section>
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-lg text-center">
      <h2 class="text-3xl/tight font-bold text-gray-900 sm:text-4xl">
        Everything your website needs
      </h2>

      <p class="mt-4 text-lg text-pretty text-gray-700">
        Turn traffic into customers with beautiful, high-converting landing
        pages.
      </p>
    </div>

    <div class="mt-8 grid grid-cols-1 gap-8 md:grid-cols-3">
      <div
        class="group rounded-lg border border-gray-200 p-6 hover:-translate-y-2 transition-all duration-300"
      >
        <div class="inline-flex rounded-lg bg-flare/10 p-3 text-flare">
          <svg
            aria-hidden="true"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="size-6"
          >
            <circle cx="12" cy="12" r="10"></circle>

            <path stroke-linecap="round" stroke-linejoin="round" d="M2 12h20"
            ></path>

            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
            ></path>
          </svg>
        </div>

        <h3
          class="group-hover:text-flare mt-4 text-lg font-semibold text-gray-900"
        >
          Website Development
        </h3>

        <p class="mt-2 text-pretty text-gray-700">
          Build a fast, modern website designed to attract visitors and turn
          them into customers. Our responsive websites are optimized for
          performance, user experience, SEO, and easy content updates.
        </p>
        <a
          href="/website-development"
          class="flex items-center text-xs mt-2 hover:text-flare-dark text-flare"
          >Explore Services <ArrowRight size={12} /></a
        >
      </div>

      <div
        class="group rounded-lg border border-gray-200 p-6 hover:-translate-y-2 transition-all duration-300"
      >
        <div class="inline-flex rounded-lg bg-flare/10 p-3 text-flare">
          <svg
            aria-hidden="true"
            xmlns="http://w3.org"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="size-6"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99"
            ></path>
          </svg>
        </div>

        <h3
          class="group-hover:text-flare mt-4 text-lg font-semibold text-gray-900"
        >
          Website Redesign
        </h3>

        <p class="mt-2 text-pretty text-gray-700">
          Give your website a fresh, modern look built to perform better. We
          redesign outdated websites with improved design, mobile
          responsiveness, user experience, speed, and SEO to help you attract
          visitors and convert more customers.
        </p>
        <a
          href="/website-development"
          class="flex items-center text-xs mt-2 hover:text-flare-dark text-flare"
          >Explore Services <ArrowRight size={12} /></a
        >
      </div>

      <div
        class="group rounded-lg border border-gray-200 p-6 hover:-translate-y-2 transition-all duration-300"
      >
        <div class="inline-flex rounded-lg bg-flare/10 p-3 text-flare">
          <svg
            aria-hidden="true"
            xmlns="http://w3.org"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="size-6"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"
            ></path>
          </svg>
        </div>

        <h3
          class="group-hover:text-flare mt-4 text-lg font-semibold text-gray-900"
        >
          SEO (Search Engine Optimization)
        </h3>

        <p class="mt-2 text-pretty text-gray-700">
          Improve your Google rankings and get found by people actively
          searching for your products or services. Our SEO strategies focus on
          relevant keywords, quality content, technical optimization, and
          long-term organic growth.
        </p><a
          href="/seo"
          class="flex items-center text-xs mt-2 hover:text-flare-dark text-flare"
          >Explore Services <ArrowRight size={12} /></a
        >
      </div>

      <div
        class="group rounded-lg border border-gray-200 p-6 hover:-translate-y-2 transition-all duration-300"
      >
        <div class="inline-flex rounded-lg bg-flare/10 p-3 text-flare">
          <svg
            aria-hidden="true"
            xmlns="http://w3.org"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="size-6"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"></path>
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"
            ></path>
          </svg>
        </div>

        <h3
          class="group-hover:text-flare mt-4 text-lg font-semibold text-gray-900"
        >
          Local SEO
        </h3>

        <p class="mt-2 text-pretty text-gray-700">
          Get discovered by more customers in your area with targeted local SEO.
          We optimize your Google Business Profile, website, and local presence
          to help you rank higher in local search and Google Maps.
        </p><a
          href="/seo"
          class="flex items-center text-xs mt-2 hover:text-flare-dark text-flare"
          >Explore Services <ArrowRight size={12} /></a
        >
      </div>

      <div
        class="group rounded-lg border border-gray-200 p-6 hover:-translate-y-2 transition-all duration-300"
      >
        <div class="inline-flex rounded-lg bg-flare/10 p-3 text-flare">
          <svg
            aria-hidden="true"
            xmlns="http://w3.org"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="size-6"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M8.625 12a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H8.25m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H12m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 0 1-2.555-.337A5.972 5.972 0 0 1 5.41 20.97a.596.596 0 0 1-.548-.126.56.56 0 0 1-.14-.498l.742-3.473C3.566 15.386 3 13.772 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25Z"
            ></path>
          </svg>
        </div>

        <h3
          class="group-hover:text-flare mt-4 text-lg font-semibold text-gray-900"
        >
          Social Media
        </h3>

        <p class="mt-2 text-pretty text-gray-700">
          Build a stronger online presence and connect with the right audience
          across social media. We create engaging content and strategic
          campaigns that increase brand awareness, drive engagement, and turn
          followers into loyal customers.
        </p><a
          href="/social-media"
          class="flex items-center text-xs mt-2 hover:text-flare-dark text-flare"
          >Explore Services <ArrowRight size={12} /></a
        >
      </div>
      <div
        class="group rounded-lg border border-gray-200 p-6 hover:-translate-y-2 transition-all duration-300"
      >
        <div class="inline-flex rounded-lg bg-flare/10 p-3 text-flare">
          <svg
            aria-hidden="true"
            xmlns="http://w3.org"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="size-6"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5"
            ></path>
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M10 13h4a2 2 0 0 1 2 2v1a2 2 0 0 1-2 2h-1l-2.5 2v-2H10a2 2 0 0 1-2-2v-1a2 2 0 0 1 2-2z"
            ></path>
          </svg>
        </div>

        <h3
          class="group-hover:text-flare mt-4 text-lg font-semibold text-gray-900"
        >
          Social Media Management
        </h3>

        <p class="mt-2 text-pretty text-gray-700">
          Stay active, consistent, and connected with your audience across
          social media. We manage your content, posting, engagement, and
          strategy to build your brand, grow your following, and turn social
          media into a valuable business channel.
        </p>
        <a
          href="/social-media"
          class="flex items-center text-xs mt-2 hover:text-flare-dark text-flare"
          >Explore Services <ArrowRight size={12} /></a
        >
      </div>
    </div>
  </div>
</section>
