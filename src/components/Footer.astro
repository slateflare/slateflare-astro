---
import { Mail } from "@lucide/astro";
---

<footer class="bg-slate">
  <div
    class="mx-auto max-w-7xl space-y-8 px-4 py-16 sm:px-6 lg:space-y-16 lg:px-8"
  >
    <div class="sm:flex sm:items-center sm:justify-between">
      <div class="w-40">
        <img src="/dark-nav-logo.png" alt="logo" />
      </div>

      <ul class="mt-8 flex justify-start gap-6 sm:mt-0 sm:justify-end">
        <li>
          <a
            href="/"
            rel="noreferrer"
            target="_blank"
            class="text-gray-200 transition hover:opacity-75"
          >
            <span class="sr-only">Instagram</span>

            <svg
              class="size-6"
              fill="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                fill-rule="evenodd"
                d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z"
                clip-rule="evenodd"></path>
            </svg>
          </a>
        </li>

        <li>
          <a
            href="/"
            rel="noreferrer"
            target="_blank"
            class="text-gray-200 transition hover:opacity-75"
          >
            <span class="sr-only">Twitter</span>

            <svg
              class="size-6"
              fill="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                fill-rule="evenodd"
                d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
                clip-rule="evenodd"></path>
            </svg>
          </a>
        </li>

        <li>
          <a
            href="/"
            rel="noreferrer"
            target="_blank"
            class="text-gray-200 transition hover:opacity-75"
          >
            <span class="sr-only">LinkedIn</span>

            <svg
              class="size-6"
              fill="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                fill-rule="evenodd"
                d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
                clip-rule="evenodd"></path>
            </svg>
          </a>
        </li>
      </ul>
    </div>

    <div
      class="grid grid-cols-1 gap-8 border-t pt-8 sm:grid-cols-2 lg:grid-cols-4 lg:pt-16 border-gray-800"
    >
      <div>
        <p class="font-medium text-white">SERVICES</p>

        <ul class="mt-6 space-y-4 text-sm">
          <li>
            <a href="/website-development" class="text-gray-200 transition hover:opacity-75">
              Website Development
            </a>
          </li>

          <li>
            <a href="/seo" class="text-gray-200 transition hover:opacity-75">
              SEO Optimization
            </a>
          </li>

          <li>
            <a href="/seo" class="text-gray-200 transition hover:opacity-75">
              Local SEO
            </a>
          </li>

          <li>
            <a href="/social-media" class="text-gray-200 transition hover:opacity-75">
              Social Media
            </a>
          </li>
        </ul>
      </div>

      <div>
        <p class="font-medium text-white">INDUSTRIES</p>

        <ul class="mt-6 space-y-4 text-sm">
          <li>
            <a href="/" class="text-gray-200 transition hover:opacity-75">
              Health Care
            </a>
          </li>

          <li>
            <a href="/" class="text-gray-200 transition hover:opacity-75">
              Real Estate
            </a>
          </li>

          <li>
            <a href="/" class="text-gray-200 transition hover:opacity-75">
              Tour & Travel
            </a>
          </li>

          <li>
            <a href="/" class="text-gray-200 transition hover:opacity-75">
              Restaurants & Cafes
            </a>
          </li>

          <li>
            <a href="/" class="text-gray-200 transition hover:opacity-75">
              Legal Services
            </a>
          </li>

          <li>
            <a href="/" class="text-gray-200 transition hover:opacity-75">
              Fitness & Wellness
            </a>
          </li>

          <li>
            <a href="/" class="text-gray-200 transition hover:opacity-75">
              Startups
            </a>
          </li>
        </ul>
      </div>

      <div>
        <p class="font-medium text-white">COMPANY</p>

        <ul class="mt-6 space-y-4 text-sm">
          <li>
            <a href="/about" class="text-gray-200 transition hover:opacity-75">
              About Us
            </a>
          </li>

          <li>
            <a href="/contact" class="text-gray-200 transition hover:opacity-75">
              Contact
            </a>
          </li>

          <li>
            <a href="/faqs" class="text-gray-200 transition hover:opacity-75">
              FAQs
            </a>
          </li>

          <li>
            <a href="/articles" class="text-gray-200 transition hover:opacity-75">
              Blogs
            </a>
          </li>
        </ul>
      </div>

      <div>
        <p class="font-medium text-white">LEGAL</p>

        <ul class="mt-6 space-y-4 text-sm">
          <li>
            <a href="/terms" class="text-gray-200 transition hover:opacity-75">
              Terms & Conditions
            </a>
          </li>

          <li>
            <a href="/privacy" class="text-gray-200 transition hover:opacity-75">
              Privacy Policy
            </a>
          </li>

          <li>
            <a href="/terms" class="text-gray-200 transition hover:opacity-75">
              Refund Policy
            </a>
          </li>
        </ul>
      </div>

      <div>
        <p class="font-medium text-white">GET IN TOUCH</p>

        <ul class="mt-6 space-y-4 text-sm">
          <li class="flex items-center gap-1">
            <Mail class="text-flare" />
            <a
              href="mailto:hello@slateflare.com"
              class="text-gray-200 transition hover:opacity-75"
            >
              hello@slateflare.com
            </a>
          </li>
        </ul>
      </div>
    </div>

    <p class="text-xs text-gray-400">
      &copy; 2026. SlateFlare Technology. All rights reserved.
    </p>
  </div>
</footer>
