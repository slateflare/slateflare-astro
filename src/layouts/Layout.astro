---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    <title>SlateFlare | Landing Page Design</title>
    <script>
      const dropdownMenu = document.querySelector(".dropdown-menu");
      const menuIcon = document.querySelector("ion-icon");

      menuIcon?.addEventListener("click", () => {
        if (!dropdownMenu || !menuIcon) return;

        const isOpen = menuIcon.getAttribute("name") === "close";

        menuIcon.setAttribute("name", isOpen ? "menu" : "close");

        dropdownMenu.classList.toggle("opacity-0", isOpen);
        dropdownMenu.classList.toggle("invisible", isOpen);
        dropdownMenu.classList.toggle("-translate-y-4", isOpen);
      });
    </script>
    <script
      type="module"
      src="https://unpkg.com/ionicons@8.0.13/dist/ionicons/ionicons.esm.js"
    ></script>
    <script
      nomodule
      src="https://unpkg.com/ionicons@8.0.13/dist/ionicons/ionicons.js"
    ></script>
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
  </body>

  <style>
    html,
    body {
      margin: 0;
      width: 100%;
      height: 100%;
    }
  </style>
</html>
