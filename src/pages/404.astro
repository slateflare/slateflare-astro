---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page Not Found | SlateFlare">
  <main
    class="flex min-h-[80vh] items-center justify-center bg-background px-6 py-20"
  >
    <section
      class="mx-auto flex max-w-6xl flex-col items-center gap-12 lg:flex-row lg:justify-between"
    >
      <div class="w-full max-w-xl text-center lg:text-left">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-flare">
          Error 404
        </p>

        <h1
          class="mt-4 text-5xl font-bold tracking-tight text-text md:text-6xl"
        >
          Page not found.
        </h1>

        <p class="mt-6 max-w-lg text-lg leading-8 text-muted">
          The page you're looking for doesn't exist or may have been moved.
          Let's get you back to somewhere useful.
        </p>

        <div
          class="mt-8 flex flex-col justify-center gap-4 sm:flex-row lg:justify-start"
        >
          <a
            href="/"
            class="inline-flex items-center justify-center rounded-xl bg-flare px-6 py-3.5 font-semibold text-white transition hover:bg-flare-dark"
          >
            Back to Home
          </a>

          <a
            href="/contact"
            class="inline-flex items-center justify-center rounded-xl border border-border bg-surface px-6 py-3.5 font-semibold text-text transition hover:border-flare hover:text-flare"
          >
            Contact Us
          </a>
        </div>
      </div>

      <div class="w-full max-w-md">
        <svg
          viewBox="0 0 600 500"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          class="h-auto w-full"
          aria-labelledby="not-found-title not-found-desc"
          role="img"
        >
          <title id="not-found-title">Page not found illustration</title>
          <desc id="not-found-desc">
            An illustration showing a missing webpage with a 404 message.
          </desc>

          <circle cx="300" cy="245" r="190" fill="#FFF1E8"></circle>

          <path
            d="M170 365H430"
            stroke="#3A424D"
            stroke-width="8"
            stroke-linecap="round"></path>

          <rect
            x="170"
            y="145"
            width="260"
            height="180"
            rx="18"
            fill="#FFFFFF"
            stroke="#171C23"
            stroke-width="8"></rect>

          <path d="M170 178H430" stroke="#E2E6EA" stroke-width="6"></path>

          <circle cx="195" cy="161" r="6" fill="#FF6B1A"></circle>
          <circle cx="215" cy="161" r="6" fill="#3A424D"></circle>
          <circle cx="235" cy="161" r="6" fill="#E2E6EA"></circle>

          <text
            x="300"
            y="245"
            text-anchor="middle"
            fill="#171C23"
            font-size="64"
            font-weight="700"
            font-family="Arial, sans-serif"
          >
            404
          </text>

          <text
            x="300"
            y="278"
            text-anchor="middle"
            fill="#69727D"
            font-size="18"
            font-weight="500"
            font-family="Arial, sans-serif"
          >
            PAGE NOT FOUND
          </text>

          <path
            d="M120 390C120 367.909 137.909 350 160 350H210C232.091 350 250 367.909 250 390V410H120V390Z"
            fill="#3A424D"></path>

          <circle
            cx="185"
            cy="330"
            r="34"
            fill="#FFB48A"
            stroke="#171C23"
            stroke-width="7"></circle>

          <path
            d="M153 324C158 300 180 290 202 300C211 304 218 312 220 323C206 315 188 314 173 322C166 326 160 327 153 324Z"
            fill="#171C23"></path>

          <path
            d="M165 339C174 347 193 348 204 338"
            stroke="#171C23"
            stroke-width="5"
            stroke-linecap="round"></path>

          <path
            d="M435 355L475 315"
            stroke="#171C23"
            stroke-width="8"
            stroke-linecap="round"></path>

          <path
            d="M455 350L490 385"
            stroke="#171C23"
            stroke-width="8"
            stroke-linecap="round"></path>

          <path
            d="M475 315L495 335"
            stroke="#FF6B1A"
            stroke-width="8"
            stroke-linecap="round"></path>

          <path
            d="M435 355L415 335"
            stroke="#FF6B1A"
            stroke-width="8"
            stroke-linecap="round"></path>

          <path
            d="M470 390C485 375 505 375 520 390"
            stroke="#3A424D"
            stroke-width="7"
            stroke-linecap="round"></path>

          <path
            d="M510 390C510 372 524 358 542 358C560 358 574 372 574 390V410H510V390Z"
            fill="#FF6B1A"></path>

          <path
            d="M542 358C528 358 518 347 518 333C518 319 528 309 542 309C556 309 566 319 566 333C566 347 556 358 542 358Z"
            fill="#FFB48A"
            stroke="#171C23"
            stroke-width="6"></path>

          <path
            d="M518 331C521 311 539 300 557 309C564 313 568 320 568 329C553 323 536 323 518 331Z"
            fill="#171C23"></path>

          <path
            d="M70 130L78 148L98 151L83 165L87 185L70 175L52 185L56 165L41 151L62 148L70 130Z"
            fill="#FF6B1A"></path>

          <path
            d="M510 100L516 114L532 116L520 127L523 143L510 135L496 143L500 127L488 116L504 114L510 100Z"
            fill="#FF6B1A"></path>

          <circle cx="100" cy="290" r="8" fill="#3A424D"></circle>
          <circle cx="520" cy="210" r="7" fill="#3A424D"></circle>
        </svg>
      </div>
    </section>
  </main>
</Layout>
