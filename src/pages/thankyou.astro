---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <main
    class="min-h-[80vh] flex items-center justify-center bg-background px-6 py-20"
  >
    <section class="w-full max-w-2xl text-center">
      <div
        class="mx-auto mb-8 flex h-20 w-20 items-center justify-center rounded-full bg-flare text-white"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-10 w-10"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M5 13l4 4L19 7"></path>
        </svg>
      </div>

      <p
        class="mb-3 text-sm font-semibold uppercase tracking-widest text-flare"
      >
        Message Received
      </p>

      <h1 class="text-4xl font-bold tracking-tight text-text sm:text-4xl">
        Thank you for reaching out!
      </h1>

      <p class="mx-auto mt-6 max-w-xl text-lg leading-8 text-muted">
        We've received your message and will get back to you as soon as
        possible. We appreciate your interest in working with SlateFlare.
      </p>

      <div class="mt-10">
        <a
          href="/"
          class="inline-flex items-center justify-center rounded-lg bg-flare px-7 py-3.5 text-sm font-semibold text-white transition hover:bg-flare-dark"
        >
          Back to Home
        </a>
      </div>
    </section>
  </main>
</Layout>
