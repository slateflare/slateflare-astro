---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <main class="bg-background">
    <section class="px-6 pb-20 pt-20 md:pb-24 md:pt-28">
      <div
        class="mx-auto grid max-w-7xl items-center gap-12 lg:grid-cols-2 lg:gap-20"
      >
        <div>
          <p
            class="text-sm font-semibold uppercase tracking-[0.2em] text-flare"
          >
            Social Media Marketing
          </p>

          <h1
            class="mt-4 text-4xl font-bold tracking-tight text-text md:text-4xl"
          >
            Build a social presence people remember.
          </h1>

          <p class="mt-6 max-w-xl text-lg leading-8 text-muted">
            We help businesses create a consistent and engaging social media
            presence that strengthens their brand, connects with their audience,
            and turns attention into meaningful action.
          </p>

          <div class="mt-8 flex flex-col gap-4 sm:flex-row">
            <a
              href="/contact"
              class="inline-flex items-center justify-center rounded-xl bg-flare px-6 py-3.5 font-semibold text-white transition hover:bg-flare-dark"
            >
              Grow Your Presence
              <span class="ml-2">→</span>
            </a>

            <a
              href="#services"
              class="inline-flex items-center justify-center rounded-xl border border-border bg-surface px-6 py-3.5 font-semibold text-text transition hover:border-flare hover:text-flare"
            >
              Explore Services
            </a>
          </div>
        </div>

        <div class="relative">
          <div
            class="rounded-3xl border border-border bg-surface p-5 shadow-sm"
          >
            <div
              class="flex items-center justify-between border-b border-border pb-5"
            >
              <div>
                <p
                  class="text-xs font-semibold uppercase tracking-wider text-muted"
                >
                  Social presence
                </p>

                <p class="mt-1 text-2xl font-bold text-text">
                  Your Brand Online
                </p>
              </div>

              <div
                class="flex h-12 w-12 items-center justify-center rounded-xl bg-flare/10"
              >
                <svg
                  class="h-6 w-6 text-flare"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9"
                  ></path>
                  <path d="M10 21h4"></path>
                </svg>
              </div>
            </div>

            <div class="mt-6 grid grid-cols-3 gap-3">
              <div class="rounded-2xl bg-background p-4 text-center">
                <p class="text-2xl font-bold text-text">24K</p>
                <p class="mt-1 text-xs text-muted">Reach</p>
              </div>

              <div class="rounded-2xl bg-background p-4 text-center">
                <p class="text-2xl font-bold text-text">8.4%</p>
                <p class="mt-1 text-xs text-muted">Engagement</p>
              </div>

              <div class="rounded-2xl bg-background p-4 text-center">
                <p class="text-2xl font-bold text-text">+32%</p>
                <p class="mt-1 text-xs text-muted">Growth</p>
              </div>
            </div>

            <div class="mt-5 rounded-2xl bg-slate p-5">
              <div class="flex items-end gap-2">
                <div class="h-12 flex-1 rounded-t-lg bg-flare/30"></div>
                <div class="h-20 flex-1 rounded-t-lg bg-flare/50"></div>
                <div class="h-16 flex-1 rounded-t-lg bg-flare/40"></div>
                <div class="h-28 flex-1 rounded-t-lg bg-flare/70"></div>
                <div class="h-24 flex-1 rounded-t-lg bg-flare/60"></div>
                <div class="h-36 flex-1 rounded-t-lg bg-flare"></div>
              </div>

              <div class="mt-4 flex items-center justify-between">
                <span class="text-xs text-white/50">Audience growth</span>

                <span class="text-xs font-semibold text-flare">
                  Growing ↑
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section
      id="services"
      class="border-y border-border bg-surface px-6 py-20 md:py-24"
    >
      <div class="mx-auto max-w-7xl">
        <div class="max-w-2xl">
          <p
            class="text-sm font-semibold uppercase tracking-[0.2em] text-flare"
          >
            What we do
          </p>

          <h2
            class="mt-3 text-3xl font-bold tracking-tight text-text md:text-4xl"
          >
            Social media built around your brand.
          </h2>

          <p class="mt-4 text-lg leading-8 text-muted">
            We help create a consistent social presence with content and
            strategies designed around your audience and business goals.
          </p>
        </div>

        <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          <article class="rounded-2xl border border-border bg-background p-7">
            <div
              class="flex h-12 w-12 items-center justify-center rounded-xl bg-flare/10"
            >
              <svg
                class="h-6 w-6 text-flare"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M4 5h16v14H4z"></path>
                <path d="m7 16 3-4 2 2 3-4 2 6"></path>
              </svg>
            </div>

            <h3 class="mt-6 text-xl font-bold text-text">Content Creation</h3>

            <p class="mt-3 leading-7 text-muted">
              Create engaging social content that communicates your brand,
              educates your audience, and keeps your profiles active.
            </p>
          </article>

          <article class="rounded-2xl border border-border bg-background p-7">
            <div
              class="flex h-12 w-12 items-center justify-center rounded-xl bg-flare/10"
            >
              <svg
                class="h-6 w-6 text-flare"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <circle cx="12" cy="12" r="9"></circle>
                <path d="M12 7v5l3 2"></path>
              </svg>
            </div>

            <h3 class="mt-6 text-xl font-bold text-text">Content Planning</h3>

            <p class="mt-3 leading-7 text-muted">
              Plan consistent content around your campaigns, audience interests,
              important dates, and business objectives.
            </p>
          </article>

          <article class="rounded-2xl border border-border bg-background p-7">
            <div
              class="flex h-12 w-12 items-center justify-center rounded-xl bg-flare/10"
            >
              <svg
                class="h-6 w-6 text-flare"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M4 4h16v12H4z"></path>
                <path d="m8 20 4-4 4 4"></path>
              </svg>
            </div>

            <h3 class="mt-6 text-xl font-bold text-text">
              Social Media Management
            </h3>

            <p class="mt-3 leading-7 text-muted">
              Keep your social channels organized, consistent, and aligned with
              your overall brand presence.
            </p>
          </article>

          <article class="rounded-2xl border border-border bg-background p-7">
            <div
              class="flex h-12 w-12 items-center justify-center rounded-xl bg-flare/10"
            >
              <svg
                class="h-6 w-6 text-flare"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M4 17 10 11l4 4 6-8"></path>
                <path d="M16 7h4v4"></path>
              </svg>
            </div>

            <h3 class="mt-6 text-xl font-bold text-text">Growth Strategy</h3>

            <p class="mt-3 leading-7 text-muted">
              Develop a practical strategy focused on reaching the right people
              and building a stronger long-term presence.
            </p>
          </article>

          <article class="rounded-2xl border border-border bg-background p-7">
            <div
              class="flex h-12 w-12 items-center justify-center rounded-xl bg-flare/10"
            >
              <svg
                class="h-6 w-6 text-flare"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M5 4h14v16H5z"></path>
                <path d="M8 8h8"></path>
                <path d="M8 12h5"></path>
                <path d="M8 16h7"></path>
              </svg>
            </div>

            <h3 class="mt-6 text-xl font-bold text-text">Brand Consistency</h3>

            <p class="mt-3 leading-7 text-muted">
              Keep your visual style, messaging, and overall identity consistent
              across your social channels.
            </p>
          </article>

          <article class="rounded-2xl border border-border bg-background p-7">
            <div
              class="flex h-12 w-12 items-center justify-center rounded-xl bg-flare/10"
            >
              <svg
                class="h-6 w-6 text-flare"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M4 19V5"></path>
                <path d="M4 19h16"></path>
                <path d="m7 15 3-4 3 2 5-7"></path>
              </svg>
            </div>

            <h3 class="mt-6 text-xl font-bold text-text">
              Performance Tracking
            </h3>

            <p class="mt-3 leading-7 text-muted">
              Review your content performance and use meaningful insights to
              understand what resonates with your audience.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="px-6 py-20 md:py-24">
      <div class="mx-auto max-w-7xl">
        <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
          <div>
            <p
              class="text-sm font-semibold uppercase tracking-[0.2em] text-flare"
            >
              Our approach
            </p>

            <h2
              class="mt-3 text-3xl font-bold tracking-tight text-text md:text-4xl"
            >
              Consistency creates recognition.
            </h2>

            <p class="mt-5 text-lg leading-8 text-muted">
              Social media works best when every post contributes to a larger
              story. We build a clear process around your brand so your audience
              knows what to expect.
            </p>
          </div>

          <ol class="space-y-5">
            <li
              class="flex gap-5 rounded-2xl border border-border bg-surface p-6"
            >
              <span
                class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-flare text-sm font-bold text-white"
              >
                01
              </span>

              <div>
                <h3 class="font-bold text-text">Understand</h3>

                <p class="mt-2 text-sm leading-6 text-muted">
                  Learn about your brand, audience, competitors, and business
                  objectives.
                </p>
              </div>
            </li>

            <li
              class="flex gap-5 rounded-2xl border border-border bg-surface p-6"
            >
              <span
                class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-flare text-sm font-bold text-white"
              >
                02
              </span>

              <div>
                <h3 class="font-bold text-text">Plan</h3>

                <p class="mt-2 text-sm leading-6 text-muted">
                  Build a content direction and posting strategy that fits your
                  brand and audience.
                </p>
              </div>
            </li>

            <li
              class="flex gap-5 rounded-2xl border border-border bg-surface p-6"
            >
              <span
                class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-flare text-sm font-bold text-white"
              >
                03
              </span>

              <div>
                <h3 class="font-bold text-text">Create</h3>

                <p class="mt-2 text-sm leading-6 text-muted">
                  Produce useful, engaging, and visually consistent content for
                  your social channels.
                </p>
              </div>
            </li>

            <li
              class="flex gap-5 rounded-2xl border border-border bg-surface p-6"
            >
              <span
                class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-flare text-sm font-bold text-white"
              >
                04
              </span>

              <div>
                <h3 class="font-bold text-text">Improve</h3>

                <p class="mt-2 text-sm leading-6 text-muted">
                  Learn from performance data and continually refine your
                  content strategy.
                </p>
              </div>
            </li>
          </ol>
        </div>
      </div>
    </section>

    <section class="bg-slate px-6 py-20 md:py-24">
      <div class="mx-auto max-w-6xl text-center">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-flare">
          Grow your presence
        </p>

        <h2
          class="mx-auto mt-4 max-w-3xl text-3xl font-bold tracking-tight text-white md:text-5xl"
        >
          Give your brand a social presence worth following.
        </h2>

        <p class="mx-auto mt-5 max-w-2xl text-lg leading-8 text-white/65">
          Let's create a social media presence that looks professional,
          communicates clearly, and keeps your brand in front of the right
          audience.
        </p>

        <a
          href="/contact"
          class="mt-8 inline-flex items-center justify-center rounded-xl bg-flare px-7 py-4 font-semibold text-white transition hover:bg-flare-dark"
        >
          Grow Your Presence
          <span class="ml-2">→</span>
        </a>
      </div>
    </section>
  </main>
</Layout>
