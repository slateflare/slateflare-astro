---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <main class="bg-background">
    <section class="px-6 pb-20 pt-20 md:pb-24 md:pt-28">
      <div
        class="mx-auto grid max-w-7xl items-center gap-12 lg:grid-cols-2 lg:gap-20"
      >
        <div>
          <p
            class="text-sm font-semibold uppercase tracking-[0.2em] text-flare"
          >
            SEO Services
          </p>

          <h1
            class="mt-4 text-4xl font-bold tracking-tight text-text md:text-4xl"
          >
            Get found by the people searching for your business.
          </h1>

          <p class="mt-6 max-w-xl text-lg leading-8 text-muted">
            We optimize websites to improve search visibility, attract relevant
            visitors, and create a stronger foundation for long-term organic
            growth.
          </p>

          <div class="mt-8 flex flex-col gap-4 sm:flex-row">
            <a
              href="/contact"
              class="inline-flex items-center justify-center rounded-xl bg-flare px-6 py-3.5 font-semibold text-white transition hover:bg-flare-dark"
            >
              Improve Your SEO
              <span class="ml-2">→</span>
            </a>

            <a
              href="#services"
              class="inline-flex items-center justify-center rounded-xl border border-border bg-surface px-6 py-3.5 font-semibold text-text transition hover:border-flare hover:text-flare"
            >
              Explore Services
            </a>
          </div>
        </div>

        <div class="relative">
          <div
            class="rounded-3xl border border-border bg-surface p-6 shadow-sm"
          >
            <div
              class="flex items-center justify-between border-b border-border pb-5"
            >
              <div>
                <p
                  class="text-xs font-semibold uppercase tracking-wider text-muted"
                >
                  Search visibility
                </p>

                <p class="mt-1 text-2xl font-bold text-text">Organic Growth</p>
              </div>

              <div
                class="flex h-12 w-12 items-center justify-center rounded-xl bg-flare/10"
              >
                <svg
                  class="h-6 w-6 text-flare"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <circle cx="11" cy="11" r="7"></circle>
                  <path d="m20 20-4-4"></path>
                </svg>
              </div>
            </div>

            <div class="mt-8 space-y-5">
              <div>
                <div class="mb-2 flex justify-between text-sm">
                  <span class="font-medium text-text">Technical SEO</span>
                  <span class="text-muted">Optimized</span>
                </div>

                <div class="h-2 rounded-full bg-border">
                  <div class="h-2 w-[92%] rounded-full bg-flare"></div>
                </div>
              </div>

              <div>
                <div class="mb-2 flex justify-between text-sm">
                  <span class="font-medium text-text">On-Page SEO</span>
                  <span class="text-muted">Optimized</span>
                </div>

                <div class="h-2 rounded-full bg-border">
                  <div class="h-2 w-[86%] rounded-full bg-flare"></div>
                </div>
              </div>

              <div>
                <div class="mb-2 flex justify-between text-sm">
                  <span class="font-medium text-text">Content Structure</span>
                  <span class="text-muted">Optimized</span>
                </div>

                <div class="h-2 rounded-full bg-border">
                  <div class="h-2 w-[78%] rounded-full bg-flare"></div>
                </div>
              </div>
            </div>

            <div class="mt-8 rounded-2xl bg-background p-5">
              <div class="flex items-center gap-3">
                <div
                  class="flex h-10 w-10 items-center justify-center rounded-xl bg-flare/10"
                >
                  <svg
                    class="h-5 w-5 text-flare"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path d="m4 16 5-5 4 4 7-8"></path>
                    <path d="M20 7v5h-5"></path>
                  </svg>
                </div>

                <div>
                  <p class="text-sm font-semibold text-text">
                    Built for search
                  </p>

                  <p class="text-xs text-muted">
                    Structured for people and search engines
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section
      id="services"
      class="border-y border-border bg-surface px-6 py-20 md:py-24"
    >
      <div class="mx-auto max-w-7xl">
        <div class="max-w-2xl">
          <p
            class="text-sm font-semibold uppercase tracking-[0.2em] text-flare"
          >
            What we do
          </p>

          <h2
            class="mt-3 text-3xl font-bold tracking-tight text-text md:text-4xl"
          >
            SEO built into your website.
          </h2>

          <p class="mt-4 text-lg leading-8 text-muted">
            We focus on the technical and on-page foundations that help search
            engines understand your website and users find what they need.
          </p>
        </div>

        <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          <article class="rounded-2xl border border-border bg-background p-7">
            <div
              class="flex h-12 w-12 items-center justify-center rounded-xl bg-flare/10"
            >
              <svg
                class="h-6 w-6 text-flare"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <circle cx="11" cy="11" r="7"></circle>
                <path d="m20 20-4-4"></path>
              </svg>
            </div>

            <h3 class="mt-6 text-xl font-bold text-text">Keyword Research</h3>

            <p class="mt-3 leading-7 text-muted">
              Identify relevant search terms and topics that align with your
              business, audience, and website goals.
            </p>
          </article>

          <article class="rounded-2xl border border-border bg-background p-7">
            <div
              class="flex h-12 w-12 items-center justify-center rounded-xl bg-flare/10"
            >
              <svg
                class="h-6 w-6 text-flare"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M4 5h16v14H4z"></path>
                <path d="M8 9h8"></path>
                <path d="M8 13h5"></path>
              </svg>
            </div>

            <h3 class="mt-6 text-xl font-bold text-text">On-Page SEO</h3>

            <p class="mt-3 leading-7 text-muted">
              Optimize page titles, headings, descriptions, content structure,
              internal links, and other important page elements.
            </p>
          </article>

          <article class="rounded-2xl border border-border bg-background p-7">
            <div
              class="flex h-12 w-12 items-center justify-center rounded-xl bg-flare/10"
            >
              <svg
                class="h-6 w-6 text-flare"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M4 6h16"></path>
                <path d="M4 12h16"></path>
                <path d="M4 18h10"></path>
              </svg>
            </div>

            <h3 class="mt-6 text-xl font-bold text-text">Technical SEO</h3>

            <p class="mt-3 leading-7 text-muted">
              Build a technically sound website with clean structure, crawlable
              pages, proper metadata, and search-friendly foundations.
            </p>
          </article>

          <article class="rounded-2xl border border-border bg-background p-7">
            <div
              class="flex h-12 w-12 items-center justify-center rounded-xl bg-flare/10"
            >
              <svg
                class="h-6 w-6 text-flare"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="m4 16 5-5 4 4 7-8"></path>
                <path d="M20 7v5h-5"></path>
              </svg>
            </div>

            <h3 class="mt-6 text-xl font-bold text-text">
              Performance Optimization
            </h3>

            <p class="mt-3 leading-7 text-muted">
              Improve loading performance and user experience with a
              lightweight, efficient website structure.
            </p>
          </article>

          <article class="rounded-2xl border border-border bg-background p-7">
            <div
              class="flex h-12 w-12 items-center justify-center rounded-xl bg-flare/10"
            >
              <svg
                class="h-6 w-6 text-flare"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M5 4h14v16H5z"></path>
                <path d="M8 8h8"></path>
                <path d="M8 12h8"></path>
                <path d="M8 16h5"></path>
              </svg>
            </div>

            <h3 class="mt-6 text-xl font-bold text-text">
              SEO Content Structure
            </h3>

            <p class="mt-3 leading-7 text-muted">
              Organize your content with clear headings, useful pages, and a
              structure that makes information easier to understand.
            </p>
          </article>

          <article class="rounded-2xl border border-border bg-background p-7">
            <div
              class="flex h-12 w-12 items-center justify-center rounded-xl bg-flare/10"
            >
              <svg
                class="h-6 w-6 text-flare"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M4 5h16v14H4z"></path>
                <path d="M8 9h8"></path>
                <path d="M8 13h5"></path>
                <path d="M17 16h.01"></path>
              </svg>
            </div>

            <h3 class="mt-6 text-xl font-bold text-text">
              SEO-Friendly Websites
            </h3>

            <p class="mt-3 leading-7 text-muted">
              Create websites with SEO considerations built into the development
              process from the beginning.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="px-6 py-20 md:py-24">
      <div class="mx-auto max-w-7xl">
        <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
          <div>
            <p
              class="text-sm font-semibold uppercase tracking-[0.2em] text-flare"
            >
              Our approach
            </p>

            <h2
              class="mt-3 text-3xl font-bold tracking-tight text-text md:text-4xl"
            >
              SEO starts with a strong foundation.
            </h2>

            <p class="mt-5 text-lg leading-8 text-muted">
              We focus on making your website understandable, accessible, and
              useful before chasing rankings.
            </p>
          </div>

          <ol class="space-y-5">
            <li
              class="flex gap-5 rounded-2xl border border-border bg-surface p-6"
            >
              <span
                class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-flare text-sm font-bold text-white"
              >
                01
              </span>

              <div>
                <h3 class="font-bold text-text">Audit</h3>
                <p class="mt-2 text-sm leading-6 text-muted">
                  Understand the current technical and content structure of your
                  website.
                </p>
              </div>
            </li>

            <li
              class="flex gap-5 rounded-2xl border border-border bg-surface p-6"
            >
              <span
                class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-flare text-sm font-bold text-white"
              >
                02
              </span>

              <div>
                <h3 class="font-bold text-text">Optimize</h3>
                <p class="mt-2 text-sm leading-6 text-muted">
                  Improve important on-page and technical SEO elements.
                </p>
              </div>
            </li>

            <li
              class="flex gap-5 rounded-2xl border border-border bg-surface p-6"
            >
              <span
                class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-flare text-sm font-bold text-white"
              >
                03
              </span>

              <div>
                <h3 class="font-bold text-text">Build</h3>
                <p class="mt-2 text-sm leading-6 text-muted">
                  Create a clean website structure designed with SEO in mind.
                </p>
              </div>
            </li>

            <li
              class="flex gap-5 rounded-2xl border border-border bg-surface p-6"
            >
              <span
                class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-flare text-sm font-bold text-white"
              >
                04
              </span>

              <div>
                <h3 class="font-bold text-text">Improve</h3>
                <p class="mt-2 text-sm leading-6 text-muted">
                  Continue refining your website as your content and business
                  grow.
                </p>
              </div>
            </li>
          </ol>
        </div>
      </div>
    </section>

    <section class="bg-slate px-6 py-20 md:py-24">
      <div class="mx-auto max-w-6xl text-center">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-flare">
          Grow your visibility
        </p>

        <h2
          class="mx-auto mt-4 max-w-3xl text-3xl font-bold tracking-tight text-white md:text-5xl"
        >
          Give your website a stronger foundation for search.
        </h2>

        <p class="mx-auto mt-5 max-w-2xl text-lg leading-8 text-white/65">
          Let's make your website easier for search engines to understand and
          easier for your customers to find.
        </p>

        <a
          href="/contact"
          class="mt-8 inline-flex items-center justify-center rounded-xl bg-flare px-7 py-4 font-semibold text-white transition hover:bg-flare-dark"
        >
          Improve Your SEO
          <span class="ml-2">→</span>
        </a>
      </div>
    </section>
  </main>
</Layout>
