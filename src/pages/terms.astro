---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <main>
    <section class="bg-background px-6 py-20 md:py-28">
      <div class="mx-auto grid max-w-7xl items-center gap-14 lg:grid-cols-2">
        <div class="max-w-2xl">
          <p
            class="mb-4 text-sm font-semibold uppercase tracking-[0.2em] text-flare"
          >
            Terms & Conditions
          </p>

          <h1 class="text-4xl font-bold tracking-tight text-text md:text-4xl">
            The terms that govern your use of SlateFlare.
          </h1>

          <p class="mt-6 text-lg leading-8 text-muted">
            These terms explain the rules and conditions that apply when you use
            our website and services. Please read them carefully before using
            SlateFlare.
          </p>

          <p class="mt-5 text-sm text-muted">
            Last updated: September 10, 2026
          </p>
        </div>

        <div class="flex justify-center lg:justify-end">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 600 500"
            class="w-full max-w-lg"
            role="img"
            aria-label="Terms and conditions illustration"
          >
            <rect width="600" height="500" rx="32" fill="#f8f9fa"></rect>

            <circle cx="455" cy="150" r="105" fill="#ff6b1a" opacity=".12"
            ></circle>

            <circle cx="120" cy="390" r="75" fill="#eef1f3"></circle>

            <rect
              x="170"
              y="70"
              width="270"
              height="350"
              rx="18"
              fill="#ffffff"
              stroke="#e2e6ea"
              stroke-width="3"></rect>

            <rect x="170" y="70" width="270" height="58" rx="18" fill="#171c23"
            ></rect>

            <rect x="170" y="108" width="270" height="20" fill="#171c23"></rect>

            <circle cx="195" cy="99" r="6" fill="#ff6b1a"></circle>
            <circle cx="216" cy="99" r="6" fill="#69727d"></circle>
            <circle cx="237" cy="99" r="6" fill="#69727d"></circle>

            <rect x="205" y="158" width="115" height="14" rx="7" fill="#171c23"
            ></rect>

            <rect x="205" y="190" width="195" height="9" rx="4.5" fill="#d6dce1"
            ></rect>

            <rect x="205" y="211" width="170" height="9" rx="4.5" fill="#d6dce1"
            ></rect>

            <rect x="205" y="252" width="195" height="9" rx="4.5" fill="#cbd2d8"
            ></rect>

            <rect x="205" y="274" width="180" height="9" rx="4.5" fill="#d6dce1"
            ></rect>

            <rect x="205" y="296" width="150" height="9" rx="4.5" fill="#d6dce1"
            ></rect>

            <rect x="205" y="338" width="195" height="9" rx="4.5" fill="#cbd2d8"
            ></rect>

            <rect x="205" y="360" width="175" height="9" rx="4.5" fill="#d6dce1"
            ></rect>

            <circle cx="440" cy="285" r="48" fill="#ff6b1a"></circle>

            <path
              d="M416 285
               L433 302
               L466 265"
              stroke="#ffffff"
              stroke-width="9"
              stroke-linecap="round"
              stroke-linejoin="round"></path>

            <path
              d="M105 185
               L118 173
               L131 185
               L126 202
               L110 202
               Z"
              fill="#ff6b1a"></path>

            <path
              d="M105 185
               L118 173
               L126 202
               L110 202
               Z"
              fill="#e94e0f"></path>

            <path
              d="M92 235
               C117 215 142 218 157 239"
              stroke="#3a424d"
              stroke-width="5"
              stroke-linecap="round"
              stroke-dasharray="8 10"></path>

            <path
              d="M475 385
               L500 370
               L492 399
               Z"
              fill="#ff6b1a"></path>

            <path
              d="M475 385
               C492 378 510 365 526 345"
              stroke="#3a424d"
              stroke-width="4"
              stroke-linecap="round"
              stroke-dasharray="7 9"></path>
          </svg>
        </div>
      </div>
    </section>

    <section class="bg-surface px-6 py-20 md:py-24">
      <div class="mx-auto max-w-4xl">
        <div class="space-y-12">
          <section>
            <h2 class="text-2xl font-bold text-text">1. Acceptance of Terms</h2>

            <p class="mt-4 leading-8 text-muted">
              By accessing or using the SlateFlare website and services, you
              agree to be bound by these Terms & Conditions. If you do not agree
              with any part of these terms, please do not use our website or
              services.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-text">2. Our Services</h2>

            <p class="mt-4 leading-8 text-muted">
              SlateFlare provides landing page design and development services.
              The specific scope, features, deliverables, timelines, and
              revisions for each project may vary depending on the agreed
              requirements.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-text">3. Project Information</h2>

            <p class="mt-4 leading-8 text-muted">
              You are responsible for providing accurate information, content,
              branding assets, images, and other materials required for your
              project. You must have the necessary rights or permissions to use
              any materials you provide.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-text">4. Payments</h2>

            <p class="mt-4 leading-8 text-muted">
              Payment terms, pricing, and any applicable fees will be
              communicated before work begins. Project work may be dependent on
              receiving the required payment or deposit according to the agreed
              terms.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-text">5. Revisions</h2>

            <p class="mt-4 leading-8 text-muted">
              Revisions are handled according to the scope agreed for your
              project. Requests that fall outside the original scope may require
              additional time or charges.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-text">
              6. Intellectual Property
            </h2>

            <p class="mt-4 leading-8 text-muted">
              Unless otherwise agreed in writing, ownership and usage rights
              relating to project deliverables will be determined by the agreed
              project terms. Third-party assets, fonts, software, and other
              licensed materials remain subject to their respective licenses.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-text">
              7. Third-Party Services
            </h2>

            <p class="mt-4 leading-8 text-muted">
              Projects may use third-party services, platforms, hosting
              providers, APIs, or other external tools. Their availability,
              functionality, and terms are controlled by the respective
              providers.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-text">8. Website Use</h2>

            <p class="mt-4 leading-8 text-muted">
              You agree not to misuse the SlateFlare website, attempt to gain
              unauthorized access, interfere with its operation, or use it for
              unlawful purposes.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-text">
              9. Limitation of Liability
            </h2>

            <p class="mt-4 leading-8 text-muted">
              To the extent permitted by applicable law, SlateFlare will not be
              liable for indirect, incidental, consequential, or other losses
              arising from the use of our website, services, or third-party
              services.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-text">
              10. Changes to These Terms
            </h2>

            <p class="mt-4 leading-8 text-muted">
              We may update these Terms & Conditions from time to time. Any
              changes will be posted on this page with an updated revision date.
              Your continued use of the website after changes are published
              constitutes acceptance of the updated terms.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-text">11. Contact</h2>

            <p class="mt-4 leading-8 text-muted">
              If you have questions about these Terms & Conditions, please
              contact us at&nbsp;
              <a
                href="mailto:hello@slateflare.com"
                class="font-medium text-flare hover:text-flare-dark"
              >
                hello@slateflare.com
              </a>.
            </p>
          </section>
        </div>
      </div>
    </section>
  </main>
</Layout>
