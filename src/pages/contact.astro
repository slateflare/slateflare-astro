---
import ContactForm from "../components/ContactForm.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <main>
    <section class="bg-surface px-6 py-20 md:py-24">
      <div class="mx-auto grid max-w-7xl gap-16 lg:grid-cols-2 lg:items-center">
        <div>
          <div class="mb-10">
            <p
              class="mb-3 text-sm font-semibold uppercase tracking-wider text-flare"
            >
              Start a conversation
            </p>

            <h2 class="text-3xl font-bold tracking-tight text-text md:text-4xl">
              Let's talk about your project.
            </h2>

            <p class="mt-5 max-w-xl leading-7 text-muted">
              Whether you have a clear idea or you're still figuring things out,
              send us a message. Tell us what you're building, what you need,
              and what you're trying to achieve.
            </p>
          </div>

          <div class="space-y-6">
            <div class="flex items-start gap-4">
              <div
                class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-background text-flare"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-5 w-5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                  <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                </svg>
              </div>

              <div>
                <h3 class="font-semibold text-text">Email</h3>
                <a
                  href="mailto:hello@slateflare.com"
                  class="mt-1 block text-muted transition hover:text-flare"
                >
                  hello@slateflare.com
                </a>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div
                class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-background text-flare"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-5 w-5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path
                    d="M22 16.92v3a2 2 0 0 1-2.18 2
                    19.79 19.79 0 0 1-8.63-3.07
                    19.5 19.5 0 0 1-6-6
                    19.79 19.79 0 0 1-3.07-8.67
                    A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72
                    12.84 12.84 0 0 0 .7 2.81
                    2 2 0 0 1-.45 2.11L8.09 9.91
                    a16 16 0 0 0 6 6l1.27-1.27
                    a2 2 0 0 1 2.11-.45
                    12.84 12.84 0 0 0 2.81.7
                    A2 2 0 0 1 22 16.92z"
                  ></path>
                </svg>
              </div>

              <div>
                <h3 class="font-semibold text-text">WhatsApp</h3>
                <a
                  href="#"
                  class="mt-1 block text-muted transition hover:text-flare"
                >
                  Start a conversation
                </a>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div
                class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-background text-flare"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-5 w-5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <circle cx="12" cy="12" r="10"></circle>
                  <path d="M12 6v6l4 2"></path>
                </svg>
              </div>

              <div>
                <h3 class="font-semibold text-text">Response time</h3>
                <p class="mt-1 text-muted">Usually within 1 business day.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="rounded-2xl border border-border bg-background p-2 md:p-8">
          <h2 class="text-2xl font-bold text-text">
            Tell us about your project
          </h2>

          <form
            class="mt-4 space-y-2"
            action="https://api.web3forms.com/submit"
            method="POST"
          >
            <input
              type="hidden"
              name="access_key"
              value="28d83143-a55c-4173-9bf7-659c1189bc7b"
            />
            <div>
              <label
                for="name"
                class="mb-2 block text-sm font-medium text-text"
              >
                Name
              </label>
              <input
                id="name"
                name="name"
                type="text"
                required
                autocomplete="name"
                placeholder="Your name"
                class="w-full rounded-lg border border-border bg-surface px-4 py-3 text-text outline-none transition placeholder:text-muted focus:border-flare focus:ring-2 focus:ring-flare/20"
              />
            </div>

            <div>
              <label
                for="email"
                class="mb-2 block text-sm font-medium text-text"
              >
                Email
              </label>
              <input
                id="email"
                name="email"
                type="email"
                required
                autocomplete="email"
                placeholder="you@example.com"
                class="w-full rounded-lg border border-border bg-surface px-4 py-3 text-text outline-none transition placeholder:text-muted focus:border-flare focus:ring-2 focus:ring-flare/20"
              />
            </div>

            <div>
              <label
                for="business"
                class="mb-2 block text-sm font-medium text-text"
              >
                Business / Project
              </label>
              <input
                id="business"
                name="business"
                type="text"
                placeholder="Your business or project name"
                class="w-full rounded-lg border border-border bg-surface px-4 py-3 text-text outline-none transition placeholder:text-muted focus:border-flare focus:ring-2 focus:ring-flare/20"
              />
            </div>

            <div>
              <label
                for="service"
                class="mb-2 block text-sm font-medium text-text"
              >
                What do you need?
              </label>
              <select
                id="service"
                name="service"
                class="w-full rounded-lg border border-border bg-surface px-4 py-3 text-text outline-none transition focus:border-flare focus:ring-2 focus:ring-flare/20"
              >
                <option value="">Select an option</option>
                <option value="landing-page">Landing Page</option>
                <option value="website-redesign"
                  >Website Development/Redesign</option
                >
                <option value="seo">SEO</option>
                <option value="social-media">Social Media</option>
                <option value="other">Other</option>
              </select>
            </div>

            <div>
              <label
                for="message"
                class="mb-2 block text-sm font-medium text-text"
              >
                Tell us about your project
              </label>
              <textarea
                id="message"
                name="message"
                rows="4"
                required
                placeholder="What are you looking to build?"
                class="w-full resize-none rounded-lg border border-border bg-surface px-4 py-3 text-text outline-none transition placeholder:text-muted focus:border-flare focus:ring-2 focus:ring-flare/20"
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full rounded-lg bg-flare px-6 py-3.5 font-semibold text-white transition hover:bg-flare-dark focus:outline-none focus:ring-2 focus:ring-flare focus:ring-offset-2"
            >
              Send Message
            </button>
          </form>
        </div>
      </div>
    </section>
  </main>
</Layout>
