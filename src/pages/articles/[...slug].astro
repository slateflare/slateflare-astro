---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { getEntry } from "astro:content";
export const getStaticPaths = async () => {
  const allArticleBlogs: CollectionEntry<"blog">[] =
    await getCollection("blog");
  return allArticleBlogs.map((entry) => {
    return {
      params: { slug: entry.data.slug },
      props: { entry },
    };
  });
};

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, description, pubDate, author, image, tags } = entry.data;
---

<Layout>
  <main class="bg-background">
    <article>
      <header class="mx-auto max-w-3xl px-6 pb-12 pt-20 text-center md:pt-28">
        <div class="flex flex-wrap items-center justify-center gap-3">
          {
            tags.map((tag) => (
              <span class="rounded-full bg-flare/10 px-3 py-1 text-xs font-semibold capitalize text-flare">
                {tag.replace("-", " ")}
              </span>
            ))
          }

          <span class="text-muted">•</span>

          <time datetime={pubDate.toISOString()} class="text-sm text-muted">
            {
              pubDate.toLocaleDateString("en-US", {
                year: "numeric",
                month: "long",
                day: "numeric",
              })
            }
          </time>
        </div>

        <h1
          class="mt-7 text-4xl font-bold tracking-tight text-text md:text-6xl md:leading-[1.08]"
        >
          {title}
        </h1>

        <p
          class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-muted md:text-xl"
        >
          {description}
        </p>

        <p class="mt-6 text-sm font-medium text-text">
          By {author}
        </p>
      </header>

      <div class="mx-auto max-w-3xl px-6">
        <div
          class="overflow-hidden rounded-2xl border border-border bg-surface shadow-sm"
        >
          <img
            src={image}
            alt={title}
            class="aspect-[16/9] w-full object-cover"
          />
        </div>
      </div>

      <div class="mx-auto max-w-3xl px-6 py-12 md:py-16">
        <div class="mb-10 border-b border-border pb-6">
          <a
            href="/articles"
            class="inline-flex items-center gap-2 text-sm font-semibold text-muted transition hover:text-flare"
          >
            <span aria-hidden="true">←</span>
            Back to Blog
          </a>
        </div>

        <div class="article-content">
          <Content />
        </div>
      </div>
    </article>

    <section class="px-6 pb-20 md:pb-24">
      <div class="mx-auto max-w-3xl">
        <div
          class="relative overflow-hidden rounded-3xl bg-slate px-8 py-14 md:px-12 md:py-16"
        >
          <div
            class="absolute -right-20 -top-20 h-64 w-64 rounded-full bg-flare/10"
          >
          </div>
          <div
            class="absolute -bottom-32 -left-20 h-72 w-72 rounded-full bg-flare/5"
          >
          </div>

          <div class="relative text-center">
            <p
              class="text-sm font-semibold uppercase tracking-[0.2em] text-flare"
            >
              Ready to get started?
            </p>

            <h2
              class="mt-4 text-3xl font-bold tracking-tight text-white md:text-4xl"
            >
              Ready to build a landing page that works?
            </h2>

            <p
              class="mx-auto mt-4 max-w-xl text-base leading-7 text-white/65 md:text-lg"
            >
              Turn your idea into a fast, professional landing page designed to
              make a strong first impression.
            </p>

            <a
              href="/contact"
              class="mt-8 inline-flex items-center justify-center rounded-xl bg-flare px-7 py-4 font-semibold text-white transition hover:bg-flare-dark"
            >
              Get Your Landing Page
              <span class="ml-2">→</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .article-content {
    color: #69727d;
    font-size: 1.125rem;
    line-height: 2;
  }

  .article-content :global(h1),
  .article-content :global(h2),
  .article-content :global(h3),
  .article-content :global(h4) {
    color: #111418;
    font-weight: 700;
    letter-spacing: -0.025em;
  }

  .article-content :global(h1) {
    margin-top: 0;
    margin-bottom: 1.5rem;
    font-size: 2.25rem;
    line-height: 1.2;
  }

  .article-content :global(h2) {
    margin-top: 3rem;
    margin-bottom: 1rem;
    font-size: 1.875rem;
    line-height: 1.3;
  }

  .article-content :global(h3) {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    font-size: 1.5rem;
    line-height: 1.4;
  }

  .article-content :global(h4) {
    margin-top: 1.75rem;
    margin-bottom: 0.75rem;
    font-size: 1.25rem;
  }

  .article-content :global(p) {
    margin-top: 1.5rem;
  }

  .article-content :global(ul) {
    margin-top: 1.5rem;
    padding-left: 1.5rem;
    list-style: disc;
  }

  .article-content :global(ol) {
    margin-top: 1.5rem;
    padding-left: 1.5rem;
    list-style: decimal;
  }

  .article-content :global(li) {
    margin-top: 0.75rem;
  }

  .article-content :global(a) {
    color: #ff6b1a;
    font-weight: 600;
    text-decoration: none;
  }

  .article-content :global(a:hover) {
    color: #e94e0f;
  }

  .article-content :global(blockquote) {
    margin: 2rem 0;
    border-left: 4px solid #ff6b1a;
    padding-left: 1.5rem;
    color: #3a424d;
    font-size: 1.25rem;
    font-style: italic;
  }

  .article-content :global(img) {
    margin: 2.5rem 0;
    width: 100%;
    border-radius: 1rem;
  }

  .article-content :global(code) {
    border-radius: 0.375rem;
    background: #f0f2f4;
    padding: 0.2rem 0.4rem;
    color: #171c23;
    font-size: 0.9em;
  }

  .article-content :global(pre) {
    margin: 2rem 0;
    overflow-x: auto;
    border-radius: 1rem;
    background: #171c23;
    padding: 1.5rem;
  }

  .article-content :global(pre code) {
    background: transparent;
    padding: 0;
    color: white;
  }

  .article-content :global(hr) {
    margin: 3rem 0;
    border: 0;
    border-top: 1px solid #e2e6ea;
  }
</style>
