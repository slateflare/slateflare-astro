---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <main class="bg-background">
    <section class="px-6 pb-20 pt-20 md:pb-24 md:pt-28">
      <div
        class="mx-auto grid max-w-7xl items-center gap-12 lg:grid-cols-2 lg:gap-20"
      >
        <div>
          <p
            class="text-sm font-semibold uppercase tracking-[0.2em] text-flare"
          >
            Website Development
          </p>

          <h1
            class="mt-4 text-4xl font-bold tracking-tight text-text md:text-4xl"
          >
            Websites built to look good and work beautifully.
          </h1>

          <p class="mt-6 max-w-xl text-lg leading-8 text-muted">
            We build fast, responsive, and professional websites that give your
            business a strong online presence and make it easy for visitors to
            take action.
          </p>

          <div class="mt-8 flex flex-col gap-4 sm:flex-row">
            <a
              href="/contact"
              class="inline-flex items-center justify-center rounded-xl bg-flare px-6 py-3.5 font-semibold text-white transition hover:bg-flare-dark"
            >
              Start Your Project
              <span class="ml-2">→</span>
            </a>

            <a
              href="#services"
              class="inline-flex items-center justify-center rounded-xl border border-border bg-surface px-6 py-3.5 font-semibold text-text transition hover:border-flare hover:text-flare"
            >
              Explore Services
            </a>
          </div>
        </div>

        <div class="relative">
          <div
            class="overflow-hidden rounded-3xl border border-border bg-surface p-4 shadow-sm"
          >
            <div class="rounded-2xl bg-slate p-5">
              <div class="flex items-center gap-2">
                <span class="h-2.5 w-2.5 rounded-full bg-white/30"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-white/30"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-flare"></span>
              </div>

              <div class="mt-6 rounded-xl bg-white p-6">
                <div class="h-3 w-24 rounded-full bg-slate"></div>
                <div class="mt-6 h-8 w-4/5 rounded-lg bg-slate"></div>
                <div class="mt-3 h-8 w-3/5 rounded-lg bg-slate"></div>

                <div class="mt-6 h-3 w-full rounded-full bg-border"></div>
                <div class="mt-2 h-3 w-4/5 rounded-full bg-border"></div>

                <div class="mt-7 h-11 w-32 rounded-xl bg-flare"></div>
              </div>
            </div>
          </div>

          <div
            class="absolute -bottom-5 -left-5 hidden rounded-2xl border border-border bg-surface p-4 shadow-lg sm:block"
          >
            <div class="flex items-center gap-3">
              <div
                class="flex h-10 w-10 items-center justify-center rounded-xl bg-flare/10"
              >
                <svg
                  class="h-5 w-5 text-flare"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="M12 3v18"></path>
                  <path d="M3 12h18"></path>
                </svg>
              </div>

              <div>
                <p class="text-sm font-semibold text-text">Responsive</p>
                <p class="text-xs text-muted">Every screen size</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section
      id="services"
      class="border-y border-border bg-surface px-6 py-20 md:py-24"
    >
      <div class="mx-auto max-w-7xl">
        <div class="max-w-2xl">
          <p
            class="text-sm font-semibold uppercase tracking-[0.2em] text-flare"
          >
            What we build
          </p>

          <h2
            class="mt-3 text-3xl font-bold tracking-tight text-text md:text-4xl"
          >
            Everything your website needs.
          </h2>

          <p class="mt-4 text-lg leading-8 text-muted">
            From the first section to the final interaction, we focus on
            creating websites that are clear, reliable, and built around your
            business goals.
          </p>
        </div>

        <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          <article class="rounded-2xl border border-border bg-background p-7">
            <div
              class="flex h-12 w-12 items-center justify-center rounded-xl bg-flare/10"
            >
              <svg
                class="h-6 w-6 text-flare"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <rect x="3" y="4" width="18" height="16" rx="2"></rect>
                <path d="M3 9h18"></path>
              </svg>
            </div>

            <h3 class="mt-6 text-xl font-bold text-text">Business Websites</h3>

            <p class="mt-3 leading-7 text-muted">
              Professional websites that clearly communicate what your business
              offers and help visitors understand your value.
            </p>
          </article>

          <article class="rounded-2xl border border-border bg-background p-7">
            <div
              class="flex h-12 w-12 items-center justify-center rounded-xl bg-flare/10"
            >
              <svg
                class="h-6 w-6 text-flare"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M4 5h16v14H4z"></path>
                <path d="M8 9h8"></path>
                <path d="M8 13h5"></path>
              </svg>
            </div>

            <h3 class="mt-6 text-xl font-bold text-text">Landing Pages</h3>

            <p class="mt-3 leading-7 text-muted">
              Focused pages designed around a specific goal, from generating
              leads to promoting a product or service.
            </p>
          </article>

          <article class="rounded-2xl border border-border bg-background p-7">
            <div
              class="flex h-12 w-12 items-center justify-center rounded-xl bg-flare/10"
            >
              <svg
                class="h-6 w-6 text-flare"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M6 3h12v18H6z"></path>
                <path d="M9 6h6"></path>
                <circle cx="12" cy="18" r="1"></circle>
              </svg>
            </div>

            <h3 class="mt-6 text-xl font-bold text-text">Responsive Design</h3>

            <p class="mt-3 leading-7 text-muted">
              Websites that adapt smoothly across desktops, tablets, and mobile
              devices without compromising the experience.
            </p>
          </article>

          <article class="rounded-2xl border border-border bg-background p-7">
            <div
              class="flex h-12 w-12 items-center justify-center rounded-xl bg-flare/10"
            >
              <svg
                class="h-6 w-6 text-flare"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M12 3v18"></path>
                <path d="M3 12h18"></path>
                <path d="m5 5 14 14"></path>
                <path d="m19 5-14 14"></path>
              </svg>
            </div>

            <h3 class="mt-6 text-xl font-bold text-text">Custom Development</h3>

            <p class="mt-3 leading-7 text-muted">
              Custom-built experiences tailored to your requirements instead of
              relying on a one-size-fits-all template.
            </p>
          </article>

          <article class="rounded-2xl border border-border bg-background p-7">
            <div
              class="flex h-12 w-12 items-center justify-center rounded-xl bg-flare/10"
            >
              <svg
                class="h-6 w-6 text-flare"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M4 17h16"></path>
                <path d="M6 13h12"></path>
                <path d="M8 9h8"></path>
                <path d="M10 5h4"></path>
              </svg>
            </div>

            <h3 class="mt-6 text-xl font-bold text-text">Performance</h3>

            <p class="mt-3 leading-7 text-muted">
              Lightweight, efficient websites built with performance in mind so
              visitors can get where they need to go quickly.
            </p>
          </article>

          <article class="rounded-2xl border border-border bg-background p-7">
            <div
              class="flex h-12 w-12 items-center justify-center rounded-xl bg-flare/10"
            >
              <svg
                class="h-6 w-6 text-flare"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M4 5h16v14H4z"></path>
                <path d="M8 9h8"></path>
                <path d="M8 13h5"></path>
                <path d="M17 16h.01"></path>
              </svg>
            </div>

            <h3 class="mt-6 text-xl font-bold text-text">
              Website Improvements
            </h3>

            <p class="mt-3 leading-7 text-muted">
              Refresh, improve, or rebuild an existing website to create a
              cleaner and more effective online experience.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="px-6 py-20 md:py-24">
      <div class="mx-auto max-w-7xl">
        <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
          <div>
            <p
              class="text-sm font-semibold uppercase tracking-[0.2em] text-flare"
            >
              Our approach
            </p>

            <h2
              class="mt-3 text-3xl font-bold tracking-tight text-text md:text-4xl"
            >
              From idea to finished website.
            </h2>

            <p class="mt-5 text-lg leading-8 text-muted">
              We keep the process straightforward, transparent, and focused on
              building something that fits your business.
            </p>
          </div>

          <ol class="space-y-5">
            <li
              class="flex gap-5 rounded-2xl border border-border bg-surface p-6"
            >
              <span
                class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-flare text-sm font-bold text-white"
              >
                01
              </span>

              <div>
                <h3 class="font-bold text-text">Understand</h3>
                <p class="mt-2 text-sm leading-6 text-muted">
                  We learn about your business, audience, goals, and
                  requirements.
                </p>
              </div>
            </li>

            <li
              class="flex gap-5 rounded-2xl border border-border bg-surface p-6"
            >
              <span
                class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-flare text-sm font-bold text-white"
              >
                02
              </span>

              <div>
                <h3 class="font-bold text-text">Design</h3>
                <p class="mt-2 text-sm leading-6 text-muted">
                  We create a clear visual direction and structure around your
                  goals.
                </p>
              </div>
            </li>

            <li
              class="flex gap-5 rounded-2xl border border-border bg-surface p-6"
            >
              <span
                class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-flare text-sm font-bold text-white"
              >
                03
              </span>

              <div>
                <h3 class="font-bold text-text">Build</h3>
                <p class="mt-2 text-sm leading-6 text-muted">
                  We turn the design into a responsive, polished,
                  production-ready website.
                </p>
              </div>
            </li>

            <li
              class="flex gap-5 rounded-2xl border border-border bg-surface p-6"
            >
              <span
                class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-flare text-sm font-bold text-white"
              >
                04
              </span>

              <div>
                <h3 class="font-bold text-text">Launch</h3>
                <p class="mt-2 text-sm leading-6 text-muted">
                  We make sure everything is ready for your website to go live.
                </p>
              </div>
            </li>
          </ol>
        </div>
      </div>
    </section>

    <section class="bg-slate px-6 py-20 md:py-24">
      <div class="mx-auto max-w-6xl text-center">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-flare">
          Start your project
        </p>

        <h2
          class="mx-auto mt-4 max-w-3xl text-3xl font-bold tracking-tight text-white md:text-5xl"
        >
          Have a website idea?
          <span class="text-flare">Let's build it.</span>
        </h2>

        <p class="mx-auto mt-5 max-w-2xl text-lg leading-8 text-white/65">
          Tell us what you're building and we'll help turn your idea into a
          professional website.
        </p>

        <a
          href="/contact"
          class="mt-8 inline-flex items-center justify-center rounded-xl bg-flare px-7 py-4 font-semibold text-white transition hover:bg-flare-dark"
        >
          Start Your Project
          <span class="ml-2">→</span>
        </a>
      </div>
    </section>
  </main>
</Layout>
