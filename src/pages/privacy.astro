---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <main>
    <section class="bg-background px-6 py-20 md:py-28">
      <div class="mx-auto grid max-w-7xl items-center gap-14 lg:grid-cols-2">
        <div class="max-w-2xl">
          <p
            class="mb-4 text-sm font-semibold uppercase tracking-[0.2em] text-flare"
          >
            Privacy Policy
          </p>

          <h1 class="text-4xl font-bold tracking-tight text-text md:text-4xl">
            Your privacy matters to us.
          </h1>

          <p class="mt-6 text-lg leading-8 text-muted">
            This Privacy Policy explains how SlateFlare collects, uses, and
            protects information when you visit our website or use our services.
          </p>

          <p class="mt-5 text-sm text-muted">
            Last updated: September 10, 2026
          </p>
        </div>

        <div class="flex justify-center lg:justify-end">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 600 500"
            class="w-full max-w-lg"
            role="img"
            aria-label="Privacy protection illustration"
          >
            <rect width="600" height="500" rx="32" fill="#f8f9fa"></rect>

            <circle cx="450" cy="145" r="105" fill="#ff6b1a" opacity=".12"
            ></circle>

            <circle cx="130" cy="390" r="75" fill="#eef1f3"></circle>

            <rect
              x="170"
              y="70"
              width="270"
              height="350"
              rx="18"
              fill="#ffffff"
              stroke="#e2e6ea"
              stroke-width="3"></rect>

            <path
              d="M170 108
               C170 97 179 70 191 70
               H419
               C431 70 440 97 440 108
               V128
               H170Z"
              fill="#171c23"></path>

            <circle cx="195" cy="99" r="6" fill="#ff6b1a"></circle>
            <circle cx="216" cy="99" r="6" fill="#69727d"></circle>
            <circle cx="237" cy="99" r="6" fill="#69727d"></circle>

            <rect x="205" y="160" width="125" height="14" rx="7" fill="#171c23"
            ></rect>

            <rect x="205" y="192" width="190" height="9" rx="4.5" fill="#d6dce1"
            ></rect>

            <rect x="205" y="214" width="165" height="9" rx="4.5" fill="#d6dce1"
            ></rect>

            <rect x="205" y="252" width="190" height="9" rx="4.5" fill="#cbd2d8"
            ></rect>

            <rect x="205" y="274" width="175" height="9" rx="4.5" fill="#d6dce1"
            ></rect>

            <rect x="205" y="296" width="150" height="9" rx="4.5" fill="#d6dce1"
            ></rect>

            <path
              d="M305 330
               C305 307 322 291 345 291
               C368 291 385 307 385 330
               V355
               H305Z"
              fill="#ff6b1a"></path>

            <rect x="318" y="340" width="54" height="45" rx="8" fill="#171c23"
            ></rect>

            <path
              d="M330 340
               V327
               C330 318 336 312 345 312
               C354 312 360 318 360 327
               V340"
              stroke="#171c23"
              stroke-width="9"
              stroke-linecap="round"></path>

            <circle cx="345" cy="360" r="6" fill="#ffffff"></circle>

            <path
              d="M345 366 V376"
              stroke="#ffffff"
              stroke-width="4"
              stroke-linecap="round"></path>

            <path
              d="M112 205
               C95 194 91 170 105 157
               C120 143 143 147 154 163
               C165 179 160 201 143 210
               C132 216 121 213 112 205Z"
              fill="#ff6b1a"></path>

            <path
              d="M114 179
               L124 189
               L143 167"
              stroke="#ffffff"
              stroke-width="6"
              stroke-linecap="round"
              stroke-linejoin="round"></path>

            <path
              d="M158 236
               C190 218 205 196 214 172"
              stroke="#3a424d"
              stroke-width="4"
              stroke-linecap="round"
              stroke-dasharray="8 10"></path>

            <path
              d="M454 350
               C482 329 505 307 517 279"
              stroke="#ff6b1a"
              stroke-width="5"
              stroke-linecap="round"
              stroke-dasharray="8 10"></path>

            <circle cx="520" cy="270" r="10" fill="#ff6b1a"></circle>
          </svg>
        </div>
      </div>
    </section>

    <section class="bg-surface px-6 py-20 md:py-24">
      <div class="mx-auto max-w-4xl">
        <div class="space-y-12">
          <section>
            <h2 class="text-2xl font-bold text-text">
              1. Information We Collect
            </h2>

            <p class="mt-4 leading-8 text-muted">
              When you contact us or use our services, we may collect
              information you voluntarily provide, such as your name, email
              address, business or project details, and the contents of your
              message.
            </p>

            <p class="mt-4 leading-8 text-muted">
              We may also collect limited technical information, such as browser
              type, device information, IP address, and basic website usage
              information when you visit our website.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-text">
              2. How We Use Your Information
            </h2>

            <p class="mt-4 leading-8 text-muted">
              We may use the information we collect to respond to inquiries,
              communicate with you about projects, provide and improve our
              services, maintain our website, and protect the security of our
              website and services.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-text">3. Contact Information</h2>

            <p class="mt-4 leading-8 text-muted">
              If you contact us through a form, email, or another communication
              method, we use the information you provide to respond to your
              request and communicate with you regarding your inquiry or
              project.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-text">
              4. Cookies and Similar Technologies
            </h2>

            <p class="mt-4 leading-8 text-muted">
              Our website may use cookies or similar technologies where
              necessary for functionality, security, analytics, or improving the
              user experience. You can control cookies through your browser
              settings.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-text">
              5. Third-Party Services
            </h2>

            <p class="mt-4 leading-8 text-muted">
              We may use third-party services to operate parts of our website or
              provide our services. These providers may process information on
              our behalf and are responsible for handling information according
              to their own privacy policies and applicable terms.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-text">6. Data Retention</h2>

            <p class="mt-4 leading-8 text-muted">
              We retain personal information only for as long as reasonably
              necessary to fulfill the purposes described in this Privacy
              Policy, provide our services, comply with legal obligations,
              resolve disputes, and enforce our agreements.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-text">7. Data Security</h2>

            <p class="mt-4 leading-8 text-muted">
              We take reasonable measures to protect information against
              unauthorized access, alteration, disclosure, or destruction.
              However, no method of transmitting or storing information online
              can be guaranteed to be completely secure.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-text">8. Your Rights</h2>

            <p class="mt-4 leading-8 text-muted">
              Depending on your location and applicable law, you may have rights
              relating to your personal information, including the right to
              request access, correction, deletion, or other forms of control
              over your information.
            </p>

            <p class="mt-4 leading-8 text-muted">
              To make a privacy-related request, contact us using the details
              provided below.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-text">9. Children's Privacy</h2>

            <p class="mt-4 leading-8 text-muted">
              Our website and services are not intended for children. We do not
              knowingly collect personal information from children through our
              website.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-text">
              10. Changes to This Privacy Policy
            </h2>

            <p class="mt-4 leading-8 text-muted">
              We may update this Privacy Policy from time to time. When we make
              changes, we will update the date shown at the top of this page.
              Your continued use of our website after an update means you
              acknowledge the revised policy.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-text">11. Contact Us</h2>

            <p class="mt-4 leading-8 text-muted">
              If you have questions about this Privacy Policy or how we handle
              your information, you can contact us at&nbsp;
              <a
                href="mailto:hello@slateflare.com"
                class="font-medium text-flare transition hover:text-flare-dark"
              >
                hello@slateflare.com
              </a>.
            </p>
          </section>
        </div>
      </div>
    </section>

    <section class="bg-surface px-6 py-20 md:py-24">
      <div class="mx-auto max-w-4xl text-center">
        <p
          class="mb-4 text-sm font-semibold uppercase tracking-[0.2em] text-flare"
        >
          Have a project in mind?
        </p>

        <h2 class="text-3xl font-bold tracking-tight text-text md:text-4xl">
          Let's build something great together.
        </h2>

        <p class="mx-auto mt-5 max-w-2xl text-lg leading-8 text-gray-600">
          Tell us about your project and we'll help turn your idea into a
          professional landing page.
        </p>

        <a
          href="/contact"
          class="mt-8 inline-flex rounded-lg bg-flare px-7 py-3.5 font-semibold text-white transition hover:bg-flare-dark"
        >
          Get Your Landing Page
        </a>
      </div>
    </section>
  </main>
</Layout>
