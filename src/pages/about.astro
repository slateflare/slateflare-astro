---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <main>
    <section class="bg-background px-6 py-20 md:py-28">
      <div class="mx-auto grid max-w-7xl items-center gap-14 lg:grid-cols-2">
        <div class="max-w-2xl">
          <p
            class="mb-4 text-sm font-semibold uppercase tracking-[0.2em] text-flare"
          >
            About SlateFlare
          </p>

          <h1 class="text-4xl font-bold tracking-tight text-text md:text-4xl">
            We build landing pages that make a strong first impression.
          </h1>

          <p class="mt-6 text-lg leading-8 text-muted">
            SlateFlare helps businesses turn their ideas into clean, modern,
            high-performing landing pages. We focus on clear messaging,
            thoughtful design, responsive layouts, and experiences that guide
            visitors toward action.
          </p>

          <a
            href="/contact"
            class="mt-8 inline-flex rounded-lg bg-flare px-7 py-3.5 font-semibold text-white transition hover:bg-flare-dark"
          >
            Start Your Project
          </a>
        </div>

        <div class="flex justify-center lg:justify-end">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 600 500"
            class="w-full max-w-xl"
            aria-label="Website design illustration"
            role="img"
          >
            <rect width="600" height="500" rx="32" fill="#f8f9fa"></rect>

            <circle cx="445" cy="150" r="105" fill="#ff6b1a" opacity=".12"
            ></circle>

            <circle cx="475" cy="360" r="70" fill="#e9edf0"></circle>

            <rect
              x="95"
              y="90"
              width="350"
              height="265"
              rx="18"
              fill="#ffffff"
              stroke="#e2e6ea"
              stroke-width="3"></rect>

            <path
              d="M95 112
               C95 100 105 90 117 90
               H423
               C435 90 445 100 445 112
               V130
               H95Z"
              fill="#171c23"></path>

            <circle cx="120" cy="110" r="6" fill="#ff6b1a"></circle>
            <circle cx="140" cy="110" r="6" fill="#69727d"></circle>
            <circle cx="160" cy="110" r="6" fill="#69727d"></circle>

            <rect x="125" y="160" width="120" height="12" rx="6" fill="#171c23"
            ></rect>

            <rect x="125" y="185" width="190" height="9" rx="4.5" fill="#d7dde2"
            ></rect>

            <rect x="125" y="204" width="155" height="9" rx="4.5" fill="#d7dde2"
            ></rect>

            <rect x="125" y="235" width="95" height="34" rx="9" fill="#ff6b1a"
            ></rect>

            <rect x="145" y="247" width="55" height="9" rx="4.5" fill="#ffffff"
            ></rect>

            <rect
              x="305"
              y="160"
              width="105"
              height="105"
              rx="15"
              fill="#f1f3f5"></rect>

            <path
              d="M330 230
               C340 210 355 199 375 190
               C382 187 388 194 384 201
               L350 250
               C345 257 337 258 332 252
               Z"
              fill="#ff6b1a"></path>

            <circle cx="355" cy="185" r="18" fill="#171c23"></circle>

            <path
              d="M350 204
               C350 204 337 218 337 235
               L367 235
               C367 218 360 207 350 204Z"
              fill="#3a424d"></path>

            <path
              d="M160 355
               L160 398
               C160 410 170 420 182 420
               H405
               C417 420 427 410 427 398
               V355"
              stroke="#3a424d"
              stroke-width="7"
              stroke-linecap="round"></path>

            <path
              d="M207 420
               L190 450"
              stroke="#3a424d"
              stroke-width="7"
              stroke-linecap="round"></path>

            <path
              d="M380 420
               L397 450"
              stroke="#3a424d"
              stroke-width="7"
              stroke-linecap="round"></path>

            <path
              d="M170 370
               C130 350 110 325 108 290"
              stroke="#ff6b1a"
              stroke-width="5"
              stroke-linecap="round"
              stroke-dasharray="8 10"></path>

            <path
              d="M430 175
               L475 145
               L458 195
               L445 177
               Z"
              fill="#ff6b1a"></path>

            <circle cx="475" cy="145" r="6" fill="#171c23"></circle>
          </svg>
        </div>
      </div>
    </section>

    <section class="bg-surface px-6 py-20 md:py-24">
      <div class="mx-auto max-w-7xl">
        <div class="max-w-3xl">
          <p
            class="mb-3 text-sm font-semibold uppercase tracking-wider text-flare"
          >
            What we believe
          </p>

          <h2 class="text-3xl font-bold tracking-tight text-text md:text-4xl">
            Simple design. Clear purpose. Better results.
          </h2>

          <p class="mt-5 text-lg leading-8 text-muted">
            A landing page should do more than look good. It should communicate
            what you offer quickly, build trust, and make it easy for visitors
            to take the next step.
          </p>
        </div>

        <div class="mt-12 grid gap-6 md:grid-cols-3">
          <article
            class="rounded-2xl border border-border bg-background p-7 hover:-translate-y-2 transiton-all duration-300"
          >
            <div
              class="mb-5 flex h-11 w-11 items-center justify-center rounded-lg bg-flare text-lg font-bold text-white"
            >
              01
            </div>

            <h3 class="text-xl font-semibold text-text">Purposeful design</h3>

            <p class="mt-3 leading-7 text-muted">
              Every section has a purpose, from the first impression to the
              final call to action.
            </p>
          </article>

          <article
            class="rounded-2xl border border-border bg-background p-7 hover:-translate-y-2 transiton-all duration-300"
          >
            <div
              class="mb-5 flex h-11 w-11 items-center justify-center rounded-lg bg-flare text-lg font-bold text-white"
            >
              02
            </div>

            <h3 class="text-xl font-semibold text-text">Clear communication</h3>

            <p class="mt-3 leading-7 text-muted">
              We keep the message focused so visitors can understand your
              business without unnecessary complexity.
            </p>
          </article>

          <article
            class="rounded-2xl border border-border bg-background p-7 hover:-translate-y-2 transiton-all duration-300"
          >
            <div
              class="mb-5 flex h-11 w-11 items-center justify-center rounded-lg bg-flare text-lg font-bold text-white"
            >
              03
            </div>

            <h3 class="text-xl font-semibold text-text">Built to perform</h3>

            <p class="mt-3 leading-7 text-muted">
              Responsive layouts, fast-loading pages, and thoughtful user
              experiences are part of every project.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="bg-surface px-6 py-20 md:py-24">
      <div class="mx-auto max-w-4xl text-center">
        <p
          class="mb-4 text-sm font-semibold uppercase tracking-[0.2em] text-flare"
        >
          Let's work together
        </p>

        <h2 class="text-3xl font-bold tracking-tight text-text md:text-4xl">
          Have an idea for your next landing page?
        </h2>

        <p class="mx-auto mt-5 max-w-2xl text-lg leading-8 text-gray-600">
          Tell us what you're building and we'll help turn your idea into a
          polished landing page.
        </p>

        <a
          href="/contact"
          class="mt-8 inline-flex rounded-lg bg-flare px-7 py-3.5 font-semibold text-white transition hover:bg-flare-dark"
        >
          Get Your Landing Page
        </a>
      </div>
    </section>
  </main>
</Layout>
